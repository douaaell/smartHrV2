<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.RHCongeController"
      spacing="20" styleClass="main-content"
      stylesheets="@../css/main.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Content starts here -->

    <!-- Cards Stats -->
    <HBox spacing="20" alignment="CENTER" prefHeight="100">
        <!-- Card Orange -->
        <VBox styleClass="card-orange" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="⏳" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                <VBox>
                    <Label fx:id="lblPendingCount" text="0" styleClass="stat-number"/>
                    <Label text="Demandes à traiter" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Card Green -->
        <VBox styleClass="card-green" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="✅" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                <VBox>
                    <Label fx:id="lblApprovedCount" text="0" styleClass="stat-number"/>
                    <Label text="Ce mois-ci" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- Card Red -->
        <VBox styleClass="card-red" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="❌" style="-fx-font-size: 30px; -fx-text-fill: rgba(255,255,255,0.7);"/>
                <VBox>
                    <Label fx:id="lblRejectedCount" text="0" styleClass="stat-number"/>
                    <Label text="Total refusés" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <!-- Filter Tabs and Actions -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <fx:define>
            <ToggleGroup fx:id="statusGroup"/>
        </fx:define>
        <ToggleButton text="Tous" toggleGroup="$statusGroup" selected="true" styleClass="filter-toggle" onAction="#handleFilterChange" userData="Tous"/>
        <ToggleButton text="En attente" toggleGroup="$statusGroup" styleClass="filter-toggle" onAction="#handleFilterChange" userData="En attente"/>
        <ToggleButton text="Approuvés" toggleGroup="$statusGroup" styleClass="filter-toggle" onAction="#handleFilterChange" userData="Validé"/>
        <ToggleButton text="Refusés" toggleGroup="$statusGroup" styleClass="filter-toggle" onAction="#handleFilterChange" userData="Refusé"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button text="📥 Exporter CSV" styleClass="btn-secondary" onAction="#handleExporterCSV"/>
        <Button text="+ Nouvelle demande" styleClass="btn-primary" onAction="#handleNouvelleDemande"/>
    </HBox>

    <!-- Tableau des congés -->
    <TableView fx:id="congesTable" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50" visible="false"/>
            <TableColumn fx:id="colEmploye" text="Employé" prefWidth="150"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
            <TableColumn fx:id="colDateDebut" text="Date Début" prefWidth="100"/>
            <TableColumn fx:id="colDateFin" text="Date Fin" prefWidth="100"/>
            <TableColumn fx:id="colDuree" text="Jours" prefWidth="80"/>
            <TableColumn fx:id="colMotif" text="Motif" prefWidth="150"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="120"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    
    <!-- Total Label -->
    <Label fx:id="lblTotalConges" text="Total: 0 congés" style="-fx-text-fill: #757575; -fx-font-size: 12px;"/>
</VBox>
