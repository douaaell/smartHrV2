<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.LoginController"
      spacing="30" 
      alignment="CENTER"
      stylesheets="@../css/main.css"
      styleClass="root">

    <padding>
        <Insets top="60" right="60" bottom="60" left="60"/>
    </padding>

    <!-- Login Container -->
    <VBox spacing="30" alignment="CENTER" styleClass="card" prefWidth="480" maxWidth="480">
        
        <!-- Header -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="SmartHR+" styleClass="app-title" style="-fx-padding: 0;"/>
            <Label text="Système de Gestion des Ressources Humaines" styleClass="header-subtitle" style="-fx-font-size: 14px;"/>
        </VBox>

        <!-- Type de compte -->
        <VBox spacing="12" alignment="CENTER">
            <Label text="Type de compte" styleClass="filter-label" alignment="CENTER" style="-fx-font-weight: bold;"/>
            <HBox spacing="0" alignment="CENTER">
                <ToggleButton fx:id="adminToggle" 
                             text="Administrateur RH" 
                             styleClass="account-toggle, account-toggle-left"
                             selected="true"/>
                <ToggleButton fx:id="employeToggle" 
                             text="Employé" 
                             styleClass="account-toggle, account-toggle-right"/>
            </HBox>
        </VBox>

        <!-- Login Form -->
        <VBox spacing="15" alignment="CENTER">
            <!-- Email -->
            <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="350">
                <Label text="Email" styleClass="filter-label"/>
                <TextField fx:id="emailField" 
                           promptText="exemple@smarthr.com" 
                           prefHeight="45"/>
            </VBox>
            
            <!-- Mot de passe -->
            <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="350">
                <Label text="Mot de passe" styleClass="filter-label"/>
                <PasswordField fx:id="passwordField" 
                           promptText="Entrez votre mot de passe" 
                           prefHeight="45"/>
            </VBox>
        </VBox>

        <!-- Login Button -->
        <Button fx:id="loginButton" 
                text="Se connecter" 
                styleClass="btn-primary"
                prefWidth="350"
                prefHeight="50"
                onAction="#handleLogin"/>

        <!-- Error Message -->
        <Label fx:id="errorLabel" 
               text="" 
               style="-fx-text-fill: #dc2626; -fx-font-size: 14px; -fx-wrap-text: true;"
               visible="false"/>
    </VBox>
</VBox>
