<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RHJustificatifsController" styleClass="main-content">

    <!-- Justificatifs Content -->

    <!-- Stats Cards -->
    <HBox spacing="20">
        <!-- Card 1 - En attente -->
        <VBox style="-fx-background-color: #F9AB00; -fx-background-radius: 10; -fx-padding: 20;" prefWidth="300" spacing="5">
            <Label text="En attente de validation" style="-fx-text-fill: white; -fx-opacity: 0.9;"/>
            <Label fx:id="lblEnAttente" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
            <Label text="documents à traiter" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 12px;"/>
        </VBox>

        <!-- Card 2 - Validés -->
        <VBox style="-fx-background-color: #188038; -fx-background-radius: 10; -fx-padding: 20;" prefWidth="300" spacing="5">
            <Label text="Justificatifs validés" style="-fx-text-fill: white; -fx-opacity: 0.9;"/>
            <Label fx:id="lblValides" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
            <Label text="documents acceptés" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 12px;"/>
        </VBox>

        <!-- Card 3 - Refusés -->
        <VBox style="-fx-background-color: #D93025; -fx-background-radius: 10; -fx-padding: 20;" prefWidth="300" spacing="5">
            <Label text="Justificatifs refusés" style="-fx-text-fill: white; -fx-opacity: 0.9;"/>
            <Label fx:id="lblRefuses" text="0" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
            <Label text="documents rejetés" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 12px;"/>
        </VBox>
    </HBox>

    <!-- Filters -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10;">
        <Label text="Filtrer par :"/>
        <ComboBox fx:id="comboStatutFilter" promptText="Statut" prefWidth="150"/>
        <TextField fx:id="txtSearchEmploye" promptText="Rechercher employé..." prefWidth="200"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="📥 Exporter CSV" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 5; -fx-cursor: hand;" onAction="#handleExportCsv"/>
        <Button text="Réinitialiser" style="-fx-background-color: white; -fx-border-color: #d1d5db; -fx-border-radius: 5;" onAction="#handleReset"/>
    </HBox>

    <!-- Table -->
    <VBox styleClass="card" spacing="15" VBox.vgrow="ALWAYS">
        <Label fx:id="lblTableTitle" text="Tous les justificatifs (0)" styleClass="card-header"/>
        <TableView fx:id="tableJustificatifs" VBox.vgrow="ALWAYS" prefHeight="450">
            <columns>
                <TableColumn fx:id="colEmploye" text="Employé" prefWidth="150"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
                <TableColumn fx:id="colDateAbsence" text="Date d'absence" prefWidth="120"/>
                <TableColumn fx:id="colDocument" text="Document" prefWidth="180"/>
                <TableColumn fx:id="colDateUpload" text="Date d'upload" prefWidth="120"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
