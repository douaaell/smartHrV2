<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.EmpMesCongesController" styleClass="main-content">

    <!-- Content starts here -->

    <!-- Stats Cards -->
    <HBox spacing="20">
        <!-- Blue Card -->
        <VBox style="-fx-background-color: #1a73e8; -fx-background-radius: 10; -fx-padding: 20;" prefWidth="300" spacing="5">
             <Label text="Congés restants" style="-fx-text-fill: white; -fx-opacity: 0.9;"/>
             <Label fx:id="lblCPRestants" text="17" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
             <Label text="jours de congés payés" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 12px;"/>
             <!-- Icon placeholder typically -->
        </VBox>



        <!-- Yellow Card -->
        <VBox style="-fx-background-color: #F9AB00; -fx-background-radius: 10; -fx-padding: 20;" prefWidth="300" spacing="5">
             <Label text="En attente" style="-fx-text-fill: white; -fx-opacity: 0.9;"/>
             <Label fx:id="lblEnAttente" text="2" style="-fx-text-fill: white; -fx-font-size: 32px; -fx-font-weight: bold;"/>
             <Label text="demande(s) en cours" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 12px;"/>
        </VBox>
    </HBox>

    <HBox spacing="15">
        <Button text="+ Nouvelle demande de congé" styleClass="primary-btn" onAction="#handleNewRequest"/>
        <Button text="📥 Exporter CSV" onAction="#handleExportCsv" style="-fx-background-color: white; -fx-text-fill: #1F2937; -fx-border-color: #D1D5DB; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
    </HBox>

    <!-- History Table -->
    <VBox styleClass="card" spacing="15">
        <Label text="Historique de mes demandes" styleClass="card-header"/>
        <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS" prefHeight="400">
            <columns>
                <TableColumn fx:id="colType" text="Type" prefWidth="150"/>
                <TableColumn fx:id="colPeriode" text="Période" prefWidth="200"/>
                <TableColumn fx:id="colJours" text="Jours" prefWidth="100"/>
                <TableColumn fx:id="colMotif" text="Motif" prefWidth="250"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                <TableColumn fx:id="colDateDemande" text="Date demande" prefWidth="150"/>
                <TableColumn fx:id="colAction" text="Actions" prefWidth="180"/>
            </columns>
             <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
