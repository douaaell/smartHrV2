<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.RHDashboardController">

    <!-- Menu Latéral -->
    <left>
        <VBox spacing="10" styleClass="sidebar" alignment="TOP_CENTER" prefWidth="200">
            <Label text="SmartRH" styleClass="app-title"/>
            <Button text="Dashboard" styleClass="sidebar-btn"/>	
            <Button text="Employés" styleClass="sidebar-btn"   onAction="#ouvrirEmployes"/>
            <Button text="Contrats" styleClass="sidebar-btn"/>
            <Button text="Congés" styleClass="sidebar-btn"/>
            <Button text="Paramètres" styleClass="sidebar-btn"/>
            <Button text="Déconnexion" styleClass="sidebar-btn"/>
        </VBox>
    </left>

    <!-- Zone principale -->
    <center>
       <VBox spacing="40" VBox.vgrow="ALWAYS">

            <!-- ✅ correction UNIQUE ici -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Header -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tableau de Bord RH" styleClass="header-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Bienvenue, RH Admin" styleClass="header-subtitle"/>
            </HBox>

            <!-- Cards principales -->
            <HBox spacing="40" alignment="CENTER" HBox.hgrow="ALWAYS">
                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
                    <Label text="120" styleClass="card-number"/>
                    <Label text="Employés" styleClass="card-title"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
                    <Label text="95" styleClass="card-number"/>
                    <Label text="Contrats Actifs" styleClass="card-title"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
                    <Label text="8" styleClass="card-number"/>
                    <Label text="Congés en Attente" styleClass="card-title"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS" alignment="CENTER">
                    <Label text="5" styleClass="card-number"/>
                    <Label text="Contrats Expirant" styleClass="card-title"/>
                </VBox>
            </HBox>

            <!-- Graphiques -->
            <HBox spacing="20" HBox.hgrow="ALWAYS">
                <VBox styleClass="chart-card" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                    <Label text="Répartition des Employés par Département"/>
                     <StackPane fx:id="pieChartContainer" VBox.vgrow="ALWAYS"  minHeight="300"/>
                </VBox>
                <VBox styleClass="chart-card"  VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                    <Label text="Congés Pris par Mois"/>
                   <StackPane fx:id="barChartContainer" VBox.vgrow="ALWAYS"  minHeight="300"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>
